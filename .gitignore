# Obsidian per-device state (settings are tracked so a clone just works; plugin code is re-downloaded)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.trash/

# Local-only notes: searchable in Obsidian on this computer, never pushed
private/*
!private/README.md

# Secrets, always
.env
*.key
**/secrets.json

.DS_Store
